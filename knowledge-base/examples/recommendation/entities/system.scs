RecommendationSystem
<- concept_recommendation_system;
=> nrel_main_idtf:
    [Система рекомендаций]
    (*
        <- lang_ru;;
    *);
-> rrel_user:
    user1;
    user2;
-> rrel_list:
    sci_fi;
    action;;

user1
=> nrel_main_idtf:
    [Пользователь 1]
    (*
        <- lang_ru;;
    *);
<- concept_user;
-> rrel_rating:
    first_rating;
-> rrel_rated_object:
    Interstellar;
-> rrel_recommended_genre:
    Suspense;
-> rrel_recommended_object:
    MazeRunner;
-> rrel_favourite_genre:
    Action;;

user2
=> nrel_main_idtf:
    [Пользователь 2]
    (*
        <- lang_ru;;
    *);
<- concept_user;
-> rrel_rating:
    second_rating;
-> rrel_rated_object:
    Matrix;
-> rrel_recommended_genre:
    Thriller;
-> rrel_recommended_object:
    MazeRunner;
-> rrel_favourite_genre:
    Thriller;;

sci_fi
=> nrel_main_idtf:
    [Научная фантастика]
    (*
        <- lang_ru;;
    *);
<- concept_list;
-> rrel_object:
    Interstellar;
    StarWars;;

action
=> nrel_main_idtf:
    [Боевики]
    (*
        <- lang_ru;;
    *);
<- concept_list;
-> rrel_object:
    Matrix;
    MazeRunner;;

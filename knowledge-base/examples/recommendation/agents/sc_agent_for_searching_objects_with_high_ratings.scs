sc_agent_for_searching_objects_with_high_ratings
=> nrel_main_idtf:
	[sc-агент поиска объектов системы рекомендаций с высокими оценками]
    (*
        <- lang_ru;;
    *);
	[sc-agent for searching objects of recommendation system with high ratings]
    (* 
        <- lang_en;;
    *);
<- abstract_sc_agent;
=> nrel_primary_initiation_condition: 
	(sc_event_after_generate_outgoing_arc => action_initiated);
=> nrel_initiation_condition_and_result: 
	(..sc_agent_for_searching_objects_with_high_ratings_condition => ..sc_agent_for_searching_objects_with_high_ratings_result);
=> nrel_sc_agent_action_class:
	action_search_objects_with_high_ratings;
<= nrel_sc_agent_key_sc_elements: 
{
	action_initiated;
	action_search_objects_with_high_ratings
};
=> nrel_inclusion: 
	.platform_independent_implementation_of_sc_agent_for_searching_objects_with_high_ratings
	(*
		<- platform_independent_abstract_sc_agent;;
		<= nrel_sc_agent_program: 
		{
			agent_program_for_searching_objects_with_high_ratings;
			program_for_searching_objects_with_high_ratings
		};;

		-> scp_agent_for_searching_objects_with_high_ratings
		(*
			<- active_sc_agent;;
		*);;  
	*);;

..sc_agent_for_searching_objects_with_high_ratings_condition
= [*
	action_search_objects_with_high_ratings _-> .._action;;
	action_initiated _-> .._action;;
	.._action _-> rrel_1:: .._recommendation_system;;
*];;

..sc_agent_for_searching_objects_with_high_ratings_result
= [*
	concept_object _-> .._object;;
*];;
